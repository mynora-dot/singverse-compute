# Match GitHub Actions ghcr_namespace, dockerhub_namespace or acr_registry/acr_namespace.
# Alternatives: docker.io/<dockerhub_namespace> or <acr_registry>/<acr_namespace>.
# Registry/namespace only, without trailing slash; does not change the Compose project.
IMAGE_PREFIX=ghcr.io/mynora-dot
# Pin the published numeric version, without v or runtime suffix (e.g. 0.1.0).
COMPUTE_VERSION=latest
# Choose cuda (NVIDIA), rocm (AMD), openvino (Intel) or rknn (Rockchip).
# Each includes CPU fallback; there is no standalone CPU image.
COMPUTE_RUNTIME=cuda
COMPUTE_HTTP_BIND=127.0.0.1
COMPUTE_HTTP_PORT=18090
COMPUTE_LAN_PAIRING_ENABLED=true
